{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creekdog.org/schema/node-v1.schema.json",
  "title": "Creekdog Node Contract v1",
  "description": "Validates the three documents a Creekdog node publishes: the node descriptor, a reports feed page, and a report. See docs/node-contract.md.",

  "$defs": {
    "iri": { "type": "string", "format": "uri" },
    "timestamp": { "type": "string", "format": "date-time" },

    "geoPoint": {
      "title": "GeoJSON Point (lat/long only)",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "items": { "type": "number" }
        }
      }
    },

    "geoPolygon": {
      "title": "GeoJSON Polygon or MultiPolygon (watershed boundary)",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "enum": ["Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array" }
      }
    },

    "watershed": {
      "type": "object",
      "required": ["type", "id", "name", "boundary"],
      "properties": {
        "type": { "const": "Watershed" },
        "id": { "$ref": "#/$defs/iri" },
        "name": { "type": "string", "minLength": 1 },
        "huc": { "type": "string", "pattern": "^[0-9]{2,12}$" },
        "boundary": { "$ref": "#/$defs/geoPolygon" }
      }
    },

    "report": {
      "title": "Published PollutionReport",
      "description": "The PUBLIC form. Presence in the feed means accepted, so there is no status field. Must not carry reporter PII or routing information.",
      "type": "object",
      "required": ["type", "id", "watershed", "category", "concern", "location", "observedAt", "modified"],
      "properties": {
        "type": { "const": "PollutionReport" },
        "id": { "$ref": "#/$defs/iri" },
        "watershed": { "$ref": "#/$defs/iri" },
        "category": { "$ref": "#/$defs/iri" },
        "concern": {
          "$ref": "#/$defs/iri",
          "description": "Resolved core concern concept, e.g. https://creekdog.org/vocab/concern/mining"
        },
        "description": { "type": "string" },
        "location": { "$ref": "#/$defs/geoPoint" },
        "photos": { "type": "array", "items": { "$ref": "#/$defs/iri" } },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "modified": { "$ref": "#/$defs/timestamp" }
      },
      "not": {
        "anyOf": [
          { "required": ["reporter"] },
          { "required": ["routing"] },
          { "required": ["status"] },
          { "required": ["outOfArea"] },
          { "required": ["submittedAt"] }
        ]
      }
    },

    "removedReport": {
      "title": "Tombstone for a previously published report",
      "description": "Tells harvesters to delete their copy. Only for reports that were actually published; rejected reports are deleted with no tombstone.",
      "type": "object",
      "required": ["type", "id", "modified"],
      "properties": {
        "type": { "const": "RemovedReport" },
        "id": { "$ref": "#/$defs/iri" },
        "modified": { "$ref": "#/$defs/timestamp" }
      }
    },

    "descriptor": {
      "title": "Node descriptor",
      "type": "object",
      "required": ["type", "id", "contractVersion", "watershed", "vocabulary", "reports", "license"],
      "properties": {
        "type": { "const": "CreekdogNode" },
        "id": { "$ref": "#/$defs/iri" },
        "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "watershed": { "$ref": "#/$defs/watershed" },
        "vocabulary": { "$ref": "#/$defs/iri" },
        "categoryScheme": { "$ref": "#/$defs/iri" },
        "reports": { "$ref": "#/$defs/iri" },
        "license": { "$ref": "#/$defs/iri" },
        "publisher": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "url": { "$ref": "#/$defs/iri" }
          }
        },
        "updated": { "$ref": "#/$defs/timestamp" }
      }
    },

    "feedPage": {
      "title": "One page of the reports feed",
      "type": "object",
      "required": ["type", "id", "items"],
      "properties": {
        "type": { "const": "Collection" },
        "id": { "$ref": "#/$defs/iri" },
        "updated": { "$ref": "#/$defs/timestamp" },
        "orderedBy": { "const": "modified-asc" },
        "next": {
          "$ref": "#/$defs/iri",
          "description": "More pages in THIS harvest run. Absent on the last page."
        },
        "nextSync": {
          "type": "string",
          "description": "Opaque cursor to pass as ?since= on the NEXT harvest run."
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/report" },
              { "$ref": "#/$defs/removedReport" }
            ]
          }
        }
      }
    }
  },

  "oneOf": [
    { "$ref": "#/$defs/descriptor" },
    { "$ref": "#/$defs/feedPage" },
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/removedReport" }
  ]
}
